# telegram/.env.example -- committed template, no real values.
# Copy this to telegram/.env (gitignored) and fill in real secrets there.
# myfiles_hub_bot.py loads telegram/.env automatically at startup (via
# python-dotenv) -- no shell exports needed for local runs.

# Bot 3 -- MyFiles Hub (@Official1LavyaMyFilesBot)
TELEGRAM_MYFILES_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
MYFILES_SMTP_EMAIL=your-sending-account@gmail.com
MYFILES_SMTP_PASSWORD=your-gmail-app-password-not-account-password

# Faculty (white-label) bot tokens -- one per BOT (not per tenant -- a
# tenant can have more than one bot, e.g. Pranav's two below) in
# telegram/config/bots.json, variable name is that bot's own `bot_token_env`
# field. Add the real line to telegram/.env only once BotFather has
# actually issued that bot's token -- until then the bot's `status` stays
# "pending_bot_registration".
FACULTY_CSARUNCHOUHAN_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
FACULTY_CAPRANAVSTUDY_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
FACULTY_CAPRANAVEXAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Cloudflare Email Service (added 2026-08-11) -- send-only transactional
# email for the student report pipeline (telegram/database/cf_email.py).
# 1lavya.com must already be onboarded for Email Sending in the Cloudflare
# dashboard (SPF/DKIM/DMARC set up there, not by this repo) before either
# of these does anything. CF_EMAIL_API_TOKEN needs "Email Sending: Edit"
# permission. CF_EMAIL_ACCOUNT_ID is your Cloudflare Account ID (Account
# Home page, right-hand sidebar) -- NOT a secret by itself, but kept here
# alongside the token for one-stop config.
CF_EMAIL_API_TOKEN=PASTE_YOUR_CLOUDFLARE_EMAIL_SENDING_API_TOKEN_HERE
CF_EMAIL_ACCOUNT_ID=PASTE_YOUR_CLOUDFLARE_ACCOUNT_ID_HERE

# Admin Portal (added 2026-08-11) -- see telegram/admin_portal/README.md.
# Generate with: python telegram/admin_portal/set_password.py <username> <password>
ADMIN_PORTAL_USERNAME=PASTE_YOUR_ADMIN_USERNAME_HERE
ADMIN_PORTAL_PASSWORD_HASH=PASTE_THE_GENERATED_HASH_HERE
ADMIN_PORTAL_SECRET_KEY=PASTE_A_RANDOM_64_CHAR_HEX_STRING_HERE
