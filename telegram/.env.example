# telegram/.env.example -- committed template, no real values.
# Copy this to telegram/.env (gitignored) and fill in real secrets there.
# Every bot/tool that needs secrets loads telegram/.env automatically at
# startup (via python-dotenv, REPO_ROOT-relative -- see FIRST_PROMPT.md's
# portability notes) -- no shell exports needed for local runs.
#
# Audited 2026-08-18 against every real os.environ.get(...)/bot_token_env
# reference in telegram/*.py -- this file lists EVERY var the code actually
# reads, not just the ones someone remembered to document. If you add a new
# os.environ.get("SOMETHING") anywhere in telegram/, add it here too in the
# same pass -- an undocumented env var is exactly the kind of thing that
# silently doesn't travel when this folder is copied to a new machine/repo.

# Bot 1 -- Study Hub (@Official1LavyaStudyBot)
# Bot 2 -- Exam Hub (@Official1LavyaExamBot)
# These two were historically set as Windows OS-level environment variables
# instead of living here -- fixed 2026-08-18 specifically because an OS env
# var does NOT travel with a folder copy the way this file does.
TELEGRAM_STUDY_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
TELEGRAM_EXAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Bot 3 -- MyFiles Hub (@Official1LavyaMyFilesBot)
TELEGRAM_MYFILES_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
MYFILES_SMTP_EMAIL=your-sending-account@gmail.com
MYFILES_SMTP_PASSWORD=your-gmail-app-password-not-account-password

# Faculty (white-label) bot tokens -- one per BOT (not per tenant -- a
# tenant can have more than one bot, e.g. Pranav's two below) in
# telegram/config/bots.json, variable name is that bot's own `bot_token_env`
# field. Add the real line to telegram/.env only once BotFather has
# actually issued that bot's token -- until then the bot's `status` stays
# "pending_bot_registration".
FACULTY_CSARUNCHOUHAN_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
FACULTY_CAPRANAVSTUDY_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
FACULTY_CAPRANAVEXAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# 1LAVYA Faculty Search -- sales-agent bots (telegram/comparator/sales-agent/,
# one client institute per bot, all running sales_agent_bot.py). Variable name is
# that client's own client_config.json's `bot_token_env` field.
# coceducation -- @Official1LavyaFacultySearchBot -- LIVE since 2026-08-24
SALES_AGENT_COCEDUCATION_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Razorpay (added 2026-08-16) -- wallet recharge Payment Links for Test
# Mode billing (telegram/database/razorpay_client.py). Live keys, from the
# Razorpay Dashboard (Settings > API Keys). Note the mixed-case variable
# NAME itself (RAZORPAY_1LAVYA_key_id, not ..._KEY_ID) -- that's exactly
# how the code reads it via os.environ.get(), case-sensitive; typing it in
# all-caps here would silently resolve to nothing.
RAZORPAY_1LAVYA_key_id=PASTE_YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_1LAVYA_key_secret=PASTE_YOUR_RAZORPAY_KEY_SECRET_HERE

# Cloudflare Email Service (added 2026-08-11) -- send-only transactional
# email for the student report pipeline (telegram/database/cf_email.py).
# 1lavya.com must already be onboarded for Email Sending in the Cloudflare
# dashboard (SPF/DKIM/DMARC set up there, not by this repo) before either
# of these does anything. CF_EMAIL_API_TOKEN needs "Email Sending: Edit"
# permission. CF_EMAIL_ACCOUNT_ID is your Cloudflare Account ID (Account
# Home page, right-hand sidebar) -- NOT a secret by itself, but kept here
# alongside the token for one-stop config.
CF_EMAIL_API_TOKEN=PASTE_YOUR_CLOUDFLARE_EMAIL_SENDING_API_TOKEN_HERE
CF_EMAIL_ACCOUNT_ID=PASTE_YOUR_CLOUDFLARE_ACCOUNT_ID_HERE

# Off-machine backup pipeline (added 2026-08-16, telegram/tools/
# backup_to_cloudflare.py + rotate_logs_to_r2.py) -- nightly R2 + D1 backup
# of platform.db/myfiles_hub.db/live-served assets, hourly log-overflow
# shipping. One Cloudflare Custom API Token (Account > Workers R2 Storage:
# Edit, Account > D1: Edit) -- CF_BACKUP_R2_ACCESS_KEY_ID/SECRET are
# deterministically DERIVED from that token (see backup_to_cloudflare.py's
# own docstring for the exact derivation), not separately generated.
# Everything below CF_BACKUP_ENCRYPTION_PASSPHRASE has a safe default
# baked into the script and only needs setting if you want to override it.
CF_BACKUP_ACCOUNT_ID=PASTE_YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
CF_BACKUP_API_TOKEN=PASTE_YOUR_CLOUDFLARE_R2_D1_API_TOKEN_HERE
CF_BACKUP_R2_ACCESS_KEY_ID=PASTE_THE_DERIVED_R2_ACCESS_KEY_ID_HERE
CF_BACKUP_R2_SECRET_ACCESS_KEY=PASTE_THE_DERIVED_R2_SECRET_ACCESS_KEY_HERE
# CF_BACKUP_ENCRYPTION_PASSPHRASE encrypts .env/creds.txt themselves before
# they ever leave this machine -- generate a real random value (e.g.
# `python -c "import secrets;print(secrets.token_urlsafe(32))"`) and ALSO
# save it in a password manager, not just here -- if this machine's disk
# dies, this line dies with it, and it's the only way the encrypted backup
# copy in R2 is ever recoverable.
CF_BACKUP_ENCRYPTION_PASSPHRASE=PASTE_A_REAL_RANDOM_PASSPHRASE_HERE
# CF_BACKUP_R2_ENDPOINT=https://<CF_BACKUP_ACCOUNT_ID>.r2.cloudflarestorage.com   # optional, derived from ACCOUNT_ID if unset
# CF_BACKUP_R2_BUCKET=1lavya-platform-backups                                    # optional, this is already the default
# CF_BACKUP_D1_DB_NAME=1lavya_platform_mirror                                    # optional, this is already the default

# Admin Portal (added 2026-08-11) -- see telegram/admin_portal/README.md.
# Generate with: python telegram/admin_portal/set_password.py <username> <password>
ADMIN_PORTAL_USERNAME=PASTE_YOUR_ADMIN_USERNAME_HERE
ADMIN_PORTAL_PASSWORD_HASH=PASTE_THE_GENERATED_HASH_HERE
ADMIN_PORTAL_SECRET_KEY=PASTE_A_RANDOM_64_CHAR_HEX_STRING_HERE
# ADMIN_PORTAL_PORT=8788   # optional, this is already the default

# --- Optional overrides, all have safe defaults -- uncomment only to change ---
# DASHBOARD_PORT=8787                                        # the pre-Admin-Portal :8787 live dashboard (tools/dashboard_server.py)
# EDGE_SCREENSHOT_BROWSER=C:\path\to\msedge.exe               # only needed if branding/smoke_test_brand_kit.py can't auto-find Edge
