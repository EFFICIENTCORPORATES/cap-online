# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored repo-wide — it is never committed.
# After editing .env, run:  python tools/apply_store_config.py
# from this folder to push the Key ID into assets/store-config.js.

# Razorpay Key ID — PUBLIC, safe to expose in the browser. Starts with
# rzp_live_ (real payments) or rzp_test_ (test mode). Find it in the
# Razorpay Dashboard under Settings > API Keys.
RAZORPAY_KEY_ID=

# Razorpay Key Secret — PRIVATE. Never put this in any file the browser
# reads (nothing under assets/ or any .html file). Not used by the site
# yet — this build only does client-side checkout with the Key ID above.
# Kept here so both keys live in one place once a real backend (order
# verification, automatic access unlock) gets built later.
RAZORPAY_KEY_SECRET=
