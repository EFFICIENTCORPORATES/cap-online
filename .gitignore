# ─── cap-online .gitignore ───────────────────────────────────────────
# Principle: no binary files in git. Source/text (.md, .html, .py, .json,
# .csv, small .svg) is tracked; everything heavy or binary is excluded.

# Documents / office binaries
**/*.pdf
**/*.docx
**/*.doc
**/*.pptx
**/*.ppt
**/*.xlsx
**/*.xls

# Images (raster)
**/*.jpg
**/*.jpeg
**/*.png
**/*.gif
**/*.bmp
**/*.tiff
**/*.tif
**/*.webp
**/*.psd
**/*.ico

# Audio
**/*.mp3
**/*.wav
**/*.m4a
**/*.aac
**/*.flac
**/*.ogg

# Video
**/*.mp4
**/*.mov
**/*.mkv
**/*.avi
**/*.webm
**/*.wmv

# Archives & executables / large binaries
**/*.zip
**/*.rar
**/*.7z
**/*.tar
**/*.gz
**/*.exe
**/*.dll
**/*.msi
**/*.bin
**/*.iso

# Explicit heavy-source folders (kept local only)
materials/icai-source/
photo-gallery/originals/
obs-setup/recordings/
obs-setup/tools/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.python-version
pip-log.txt

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Editor / OS
.idea/
.vscode/
.ipynb_checkpoints/
.spyproject
.DS_Store
Thumbs.db
local_settings.py
